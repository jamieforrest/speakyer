# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real tokens.

# HuggingFace token for downloading Whisper model weights (read-only token is sufficient).
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=hf_...

# Speakyer settings (all optional — defaults shown below)
# SPEAKYER_DB_PATH=./speakyer.db
# SPEAKYER_DATA_DIR=./data
# SPEAKYER_SOURCES_YAML=./sources.yaml
# SPEAKYER_WHISPER_MODEL=mlx-community/whisper-large-v3-mlx
# SPEAKYER_ANKI_CONNECT_URL=http://localhost:8765
# SPEAKYER_TRANSLATION_MODEL=Helsinki-NLP/opus-mt-de-en  # set to "none" to disable translation
